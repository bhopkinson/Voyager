# Copy to .env and fill in values — the actual .env is gitignored.

# ── Project isolation (worktree support) ─────────────────────────────────────
# Set a unique value per git worktree to avoid container and network conflicts.
# The Makefile auto-derives this from the current git branch name.
# Override manually if needed: e.g. COMPOSE_PROJECT_NAME=voyager-feature-x
COMPOSE_PROJECT_NAME=voyager

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=voyager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/voyager

# ── Frontend ──────────────────────────────────────────────────────────────────
# When running two worktrees simultaneously, set different ports per worktree
# to avoid conflicts (e.g. FRONTEND_PORT=3001, BACKEND_PORT=8001).
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Required for Google Places autocomplete in PlaceForm.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
